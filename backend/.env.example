# Google Gemini API Key (Required for Voice STT, NL-to-SQL, and Intent Routing)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud Database (Optional: provides real-time cloud database replication; fallback is local SQLite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
