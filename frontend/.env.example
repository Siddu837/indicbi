# For Local Development (Default rewrites to http://localhost:8001):
# BACKEND_URL=http://localhost:8001

# For Vercel Deployment:
# Set BACKEND_URL in your Vercel Project Settings -> Environment Variables
# pointing to your deployed FastAPI backend (e.g., https://your-backend.onrender.com)
BACKEND_URL=http://127.0.0.1:8001
